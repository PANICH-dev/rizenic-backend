# RIZENIC production configuration example
# Copy values into your hosting environment. Do NOT commit real secrets.
NODE_ENV=production
DATABASE_URL=
PORT=3000

# Signed login session. Use a long random value in production.
APP_SESSION_SECRET=
SESSION_TTL_SECONDS=43200
# auto = Secure cookie only when request is HTTPS (recommended for mixed LAN/proxy environments)
# always = force Secure, never = force non-Secure
COOKIE_SECURE=auto

# PostgreSQL runtime safety (no schema/index changes)
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=7000
PG_QUERY_TIMEOUT_MS=120000
PG_STATEMENT_TIMEOUT_MS=120000
# auto/default: do not force SSL; DATABASE_URL ?sslmode=... is honored by node-postgres.
# For a local/LAN PostgreSQL that does not support SSL, leave PG_SSL_MODE blank or set disable.
# For providers that require TLS, use require; for certificate verification use verify.
PG_SSL_MODE=
PG_SSL_VERIFY=0

# Optional origins only if a separate frontend must call this API.
CORS_ORIGINS=

# LINE Messaging API. Keep real values in hosting secrets/environment variables.
LINE_RANGSIT_CHANNEL_TOKEN=
LINE_RANGSIT_GROUP_ID=
LINE_NAVAMIN_CHANNEL_TOKEN=
LINE_NAVAMIN_GROUP_ID=
LINE_TIMEOUT_MS=10000

# Dynamic sync. Existing integrations keep working by default after table/column validation.
# When all external clients are ready, set SYNC_REQUIRE_API_KEY=1 and give them SYNC_API_KEY.
SYNC_REQUIRE_API_KEY=0
SYNC_API_KEY=
# Optional comma-separated exact table whitelist. Blank uses the built-in restricted allowlist.
SYNC_ALLOWED_TABLES=
SYNC_MAX_ROWS=5000

# API compression: auto/off/force. Production defaults are fail-safe.
API_GZIP_MODE=auto
