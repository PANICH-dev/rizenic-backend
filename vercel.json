{
  "version": 2,
  "builds": [
    {
      "src": "app.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "public/**",
          "node_modules/@fortawesome/fontawesome-free/**",
          "node_modules/@fontsource/kanit/**",
          "node_modules/@fontsource/prompt/**",
          "node_modules/@fontsource/noto-sans-thai/**",
          "node_modules/xlsx/dist/**"
        ]
      }
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/app.js"
    }
  ]
}
